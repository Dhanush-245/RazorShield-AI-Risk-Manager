RAZORSHIELD_ENVIRONMENT=development
RAZORSHIELD_DATABASE_URL=sqlite:///./razorshield.db
RAZORSHIELD_ALLOWED_ORIGINS=["http://localhost:5173"]
RAZORSHIELD_LOG_LEVEL=INFO
RAZORSHIELD_JWT_SECRET=replace-with-at-least-32-random-characters
RAZORSHIELD_ACCESS_TOKEN_MINUTES=15
RAZORSHIELD_RESET_TOKEN_MINUTES=10
RAZORSHIELD_OTP_MINUTES=5
RAZORSHIELD_OTP_MAX_ATTEMPTS=5
RAZORSHIELD_MAXIMUM_REQUEST_BYTES=10485760
RAZORSHIELD_RATE_LIMIT_BACKEND=memory
RAZORSHIELD_OTP_DELIVERY_PROVIDER=development-console
RAZORSHIELD_TWILIO_ACCOUNT_SID=
RAZORSHIELD_TWILIO_AUTH_TOKEN=
RAZORSHIELD_TWILIO_VERIFY_SERVICE_SID=
RAZORSHIELD_SECRET_PROVIDER=development-env
RAZORSHIELD_GOOGLE_CLOUD_PROJECT=
RAZORSHIELD_RAG_PROVIDER=bounded-local
RAZORSHIELD_GEMINI_API_KEY=
RAZORSHIELD_IEEE_CIS_PROMOTION_STATUS=candidate
RAZORSHIELD_MODEL_DIR=../ml/artifacts
RAZORSHIELD_IEEE_CIS_MODEL_DIR=../ml/artifacts/ieee_cis_v2
RAZORSHIELD_AUTO_SEED_DEMO=true
VITE_DEV_API_TARGET=http://127.0.0.1:5001
