# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
playwright-report/
test-results/
*.db
.env
.env.*
!.env.example
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.pem
*.key
outputs/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Licensed/large ML inputs and generated real-data outputs
ml/data/raw/*.csv
ml/data/raw/*.zip
ml/data/processed/*
!ml/data/processed/.gitkeep
ml/reports/*
!ml/reports/.gitkeep
ml/models/real/*
!ml/models/real/.gitkeep
# Candidate artifacts trained on separately licensed competition data stay local.
ml/artifacts/ieee_cis_*/*.pkl
